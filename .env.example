# ============ IAs (OpenAI-compatibles) ============
# Podés configurar UNA o las DOS. Si configurás las dos, la app reparte
# los proyectos en paralelo entre ambas para no consumir la cuota de cada una.

# --- Proveedor 1: Gemini (Google AI Studio, tier gratis) ---
# Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Proveedor 2: Groq (tier gratis) ---
# Clave en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ============ GitHub ============
# Opcional pero recomendado: sube el rate limit de la API de 60 a 5000 req/h.
# https://github.com/settings/tokens (classic, sin scopes extra: solo público)
GITHUB_TOKEN=
